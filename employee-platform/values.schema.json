{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",

  "properties": {

    "app": {
      "type": "object",

      "properties": {

        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },

        "image": {
          "type": "object",

          "properties": {

            "repository": {
              "type": "string",
              "minLength": 1
            },

            "tag": {
              "type": "string"
            },

            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }

          },

          "required": [
            "repository",
            "pullPolicy"
          ]
        }

      }

    },

    "service": {

      "type": "object",

      "properties": {

        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },

        "port": {
          "type": "integer"
        }

      }

    },

    "postgres": {

      "type": "object",

      "properties": {

        "database": {
          "type": "string",
          "minLength": 1
        },

        "port": {
          "type": "integer"
        },

        "image": {

          "type": "object",

          "properties": {

            "repository": {
              "type": "string",
              "minLength": 1
            },

            "tag": {
              "type": "string"
            },

            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }

          },

          "required": [
            "repository",
            "pullPolicy"
          ]
        }

      }

    }

  }
}